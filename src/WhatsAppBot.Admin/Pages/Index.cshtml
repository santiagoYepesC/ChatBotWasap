@page
@model WhatsAppBot.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">RESUMEN DEL SISTEMA</p>
        <h1>Dashboard</h1>
        <p class="muted">Estado inicial de tu espacio de WhatsAppBot.</p>
    </div>
    <div class="date-chip"><span class="status-dot"></span> POC en configuración</div>
</section>

<section class="summary-grid" aria-label="Estado del sistema">
    <article class="summary-card">
        <div class="card-topline"><span class="card-icon green">◎</span><span class="state-pill neutral">Pendiente</span></div>
        <p class="card-label">WhatsApp Business</p>
        <h2>No conectado</h2>
        <p class="card-caption">La conexión oficial se configurará en una siguiente etapa.</p>
    </article>
    <article class="summary-card">
        <div class="card-topline"><span class="card-icon violet">✳</span><span class="state-pill @(Model.BotConfiguration?.IsBotEnabled == true ? "ready" : "neutral")">@(Model.BotConfiguration?.IsBotEnabled == true ? "Activo" : "Inactivo")</span></div>
        <p class="card-label">Automatización</p>
        <h2>Bot @(Model.BotConfiguration?.IsBotEnabled == true ? "activo" : "desactivado")</h2>
        <p class="card-caption">Modo: @(Model.BotConfiguration?.ReplyMode.ToString() ?? "No disponible")</p>
    </article>
    <article class="summary-card welcome-card">
        <div class="card-topline"><span class="card-icon blue">✓</span><span class="state-pill ready">Sesión segura</span></div>
        <p class="card-label">Cuenta administrativa</p>
        <h2>Hola, @User.Identity?.Name</h2>
        <p class="card-caption">Tu acceso al panel está protegido y activo.</p>
    </article>
</section>

@if (Model.ConfigurationError is not null)
{
    <div class="alert alert-warning mt-3" role="status">@Model.ConfigurationError</div>
}

<section class="content-card setup-card">
    <div class="setup-copy">
        <p class="eyebrow">CONFIGURACIÓN</p>
        <h2>Administra el comportamiento del bot</h2>
        <p>Configura el estado, el modo de respuesta y las respuestas frecuentes. La conexión de WhatsApp y el procesamiento de mensajes se incorporarán en etapas posteriores.</p>
    </div>
    <div class="row-actions">
        <a asp-page="/Settings/Bot/Index" class="btn btn-sm btn-outline-secondary">Configurar bot</a>
        <a asp-page="/Settings/FrequentResponses/Index" class="btn btn-sm btn-outline-secondary">Respuestas frecuentes</a>
    </div>
</section>
